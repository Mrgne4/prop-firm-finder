{
  "name": "prop-firm-finder",
  "private": true,
  "version": "0.1.0-prototype",
  "type": "module",
  "description": "Comparateur éducatif de prop firms — application statique (GitHub Pages)",
  "scripts": {
    "dev": "vite",
    "validate": "tsx scripts/validate-data.ts",
